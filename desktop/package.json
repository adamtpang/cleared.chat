{
  "name": "cleared-chat-desktop",
  "version": "0.5.2",
  "private": true,
  "description": "A standalone WhatsApp-first voice inbox with task planning and unsent drafts",
  "author": "Adam Pangelinan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.2"
  },
  "build": {
    "appId": "chat.cleared.desktop",
    "productName": "cleared.chat",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "**/node_modules/**/*",
          "!**/.env",
          "!**/.license.json",
          "!wa-auth*/**",
          "!snapshots/**",
          "!wa-store.json"
        ]
      },
      {
        "from": "voice-listen.ps1",
        "to": "voice-listen.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "legalTrademarks": ""
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "cleared.chat",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "afterPack": "./afterPack.cjs",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
