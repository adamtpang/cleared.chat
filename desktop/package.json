{
  "name": "cleared-chat-desktop",
  "version": "0.5.2",
  "private": true,
  "description": "A standalone WhatsApp-first voice inbox with task planning and unsent drafts",
  "author": "Adam Pangelinan",
  "main": "main.js",
  "scripts": {
    "favicon": "node scripts/make-favicon.mjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "tar": "7.5.21",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@1": "1.1.20",
    "brace-expansion@2": "2.1.6",
    "brace-expansion@5": "5.0.11",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "undici@6": "6.29.1",
    "undici@7": "7.30.1"
  },
  "build": {
    "appId": "chat.cleared.desktop",
    "productName": "cleared.chat",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "**/node_modules/**/*",
          "!**/.env",
          "!**/.license.json",
          "!wa-auth*/**",
          "!snapshots/**",
          "!wa-store.json"
        ]
      },
      {
        "from": "voice-listen.ps1",
        "to": "voice-listen.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "legalTrademarks": ""
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "cleared.chat",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "afterPack": "./afterPack.cjs",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
