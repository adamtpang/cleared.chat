# Copy to .env to customize the local app. Real mode is the default.

# Direct WhatsApp is enabled by default and does not need Beeper Desktop.
# Pair from Settings inside the app. Set this to 0 only to disable it.
WHATSAPP_DIRECT=1

# Received WhatsApp voice notes are downloaded temporarily, transcribed locally,
# and deleted. Requires Python plus faster-whisper. The model downloads once.
VOICE_TRANSCRIPTION=1
WHISPER_MODEL=small
# WHISPER_PYTHON=python

# Email is outside the messaging inbox-zero pass unless explicitly enabled.
EMAIL_ENABLED=0

DEMO=0

# Optional legacy bridge. Leave disabled for the standalone direct-source app.
BEEPER_ENABLED=0
BEEPER_ACCESS_TOKEN=

# Ranking uses your Claude SUBSCRIPTION by default (no API credits), through the
# Claude Code CLI. Requires Claude Code installed and logged in.
LLM=cli
CLAUDE_MODEL=sonnet

# To use a pay-as-you-go API key instead, uncomment these:
# LLM=api
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

BEEPER_API_BASE=http://127.0.0.1:23373
PORT=4317
