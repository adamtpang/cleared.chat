FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates ffmpeg git python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci --omit=dev

RUN python3 -m venv /opt/cleared-voice \
  && /opt/cleared-voice/bin/pip install --no-cache-dir faster-whisper

ENV HF_HOME=/opt/cleared-whisper \
  WHISPER_MODEL=tiny

RUN /opt/cleared-voice/bin/python -c "from faster_whisper import WhisperModel; WhisperModel('tiny', device='cpu', compute_type='int8')"

COPY web ./web
COPY cloud ./cloud
COPY icon.svg ./icon.svg
COPY favicon.ico ./favicon.ico

ENV NODE_ENV=production \
  CLOUD_DATA_DIR=/data \
  MAX_ACCOUNTS=3 \
  VOICE_TRANSCRIPTION=1 \
  PATH="/opt/cleared-voice/bin:${PATH}"

EXPOSE 8080

CMD ["node", "cloud/gateway.mjs"]
